-- The Function to handle the RCFA Ball
local function handleRCFABall(ball)
    if not ball:IsA("BasePart") then return end
    
    local sphere = ball:FindFirstChild("RCFAMagnetSphere")
    if not sphere then
        sphere = Instance.new("Part")
        sphere.Name = "RCFAMagnetSphere"
        sphere.Shape = Enum.PartType.Ball
        sphere.Material = Enum.Material.ForceField
        sphere.Anchored = false
        sphere.CanCollide = false
        -- THE FIXES:
        sphere.Massless = true -- Prevents the ball from flinging/getting heavy
        sphere.CanTouch = false -- Prevents it from triggering game catch logic early
        sphere.CanQuery = false -- Prevents it from blocking clicks/raycasts
        sphere.CastShadow = false
        sphere.Parent = ball
    end

    -- Update properties
    sphere.Size = Vector3.new(RCFAMagnetRange, RCFAMagnetRange, RCFAMagnetRange)
    sphere.Color = RCFAMagnetColor
    sphere.Transparency = RCFAMagnetEnabled and RCFAMagnetTransparency or 1
    
    -- Positioning (Keep it centered on the ball)
    sphere.CFrame = ball.CFrame

    if RCFAMagnetEnabled then
        local char = game.Players.LocalPlayer.Character
        local hitbox = char and (char:FindFirstChild("Hitbox") or char:FindFirstChild("HumanoidRootPart"))
        
        if hitbox then
            local dist = (hitbox.Position - ball.Position).Magnitude
            -- Using Range/2 because Range is the diameter of the sphere
            if dist <= (RCFAMagnetRange / 2) then
                firetouchinterest(hitbox, ball, 0)
                task.wait()
                firetouchinterest(hitbox, ball, 1)
            end
        end
    end
end

