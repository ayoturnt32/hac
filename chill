-- FUNCTION: Set Pass Mode automatically
local function ensurePassMode()
    local char = LocalPlayer.Character
    local hb = char and char:FindFirstChild("Hitbox")
    local cv = hb and hb:FindFirstChild("CharacterValues")
    local mode = cv and cv:FindFirstChild("Mode")
    
    -- Force the game state into Pass Mode via Remote if needed
    if mode and mode.Value ~= "Pass" then
        local tool = char:FindFirstChildWhichIsA("Tool")
        local remote = tool and tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("RemoteEvent")
        if remote then
            -- This triggers the switch animation and state logic found in your ball script
            remote:FireServer({"Switch Hands"}) 
        end
    end
end

-- FUNCTION: Find Teammates
local function getTeammateUnderMouse()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    local camera = workspace.CurrentCamera
    
    -- Priority 1: Direct Mouse Target
    if target then
        local pChar = target:FindFirstAncestorOfClass("Model")
        local pPlr = pChar and game.Players:GetPlayerFromCharacter(pChar)
        if pPlr and pPlr ~= LocalPlayer and pPlr.Team == LocalPlayer.Team then
            return pChar
        end
    end

    -- Priority 2: Sphere/Radius check for precision
    local best, dist = nil, 15
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team == LocalPlayer.Team and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local mag = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if mag < dist then
                        dist = mag
                        best = p.Character
                    end
                end
            end
        end
    end
    return best
end

-- FUNCTION: "The Dart" Physics Calculation
local function calculateDartPath(targetChar)
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    local hum = targetChar:FindFirstChild("Humanoid")
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not hrp or not myHrp then return nil end

    local power = 95 -- High power for Dart velocity
    local dist = (hrp.Position - myHrp.Position).Magnitude
    local flightTime = dist / (power * 1.8) -- Accelerated flight time

    -- Lead Calculation (Speed + Direction)
    local leadPos = hrp.Position + (hrp.Velocity * flightTime * qbLeadFactor)
    
    -- Jump/Height Adjustment
    -- If they are jumping, we aim for the peak; if running, we aim for the numbers
    local heightOffset = 2.5 
    if hum and hum:GetState() == Enum.HumanoidStateType.Jumping then
        heightOffset = 5.5 -- Aim higher for jumping receivers
    end

    -- Gravity Compensation (The "Dart" doesn't arc much)
    -- We add a slight upward tilt to counter the -41.3 gravity in your script
    local gravityCorrection = Vector3.new(0, (dist * 0.12), 0) 
    
    return leadPos + Vector3.new(0, heightOffset, 0) + gravityCorrection
end

