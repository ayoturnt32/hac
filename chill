-- POWER
local function power()
    return plr.Character.PowerValue.Value
end
 
local adjustingPower = false
local function adjustPower(target)
    if adjustingPower then return end
    adjustingPower = true
    while power() ~= target do
        if power() < target then
            plr.Character.Events.PowerUp:FireServer()
        else
            plr.Character.Events.PowerDown:FireServer()
        end
        task.wait(0.1)
    end
    adjustingPower = false
end
 
-- AUTO POWER LOOP
local function stepped()
    if not _G.autopower or not hasBall or not plr.Character then return end
    local dist = math.floor(select(1, getGoal()))
    if jumping and dist <= 12 then adjustPower(25)
    elseif dist >= 13 and dist <= 16 then adjustPower(30)
    elseif dist <= 21 then adjustPower(35)
    elseif dist <= 26 then adjustPower(40)
    elseif dist <= 31 then adjustPower(45)
    elseif dist <= 33 then adjustPower(50)
    elseif dist <= 41 then adjustPower(55)
    elseif dist <= 46 then adjustPower(60)
    elseif dist <= 50 then adjustPower(65)
    elseif dist <= 56 then adjustPower(70)
    elseif dist <= 61 then adjustPower(75)
    elseif dist <= 65 then adjustPower(80)
    elseif dist <= 74 then adjustPower(85)
    elseif dist <= 76 then adjustPower(90)
    end
end
 
-- ARC CALC
local function arc()
    local dist = math.floor(select(1, getGoal()))
    local arcs = {
        [12]=15,[13]=15,[14]=20,[15]=20,[16]=15,[17]=15,[18]=25,[19]=20,
        [20]=20,[21]=20,[22]=25,[23]=25,[24]=20,[25]=20,[26]=15,
        [27]=25,[28]=25,[29]=20,[30]=20,[31]=13,[32]=8,[33]=8,
        [34]=6,[35]=6,[36]=6,[37]=12,[38]=12,[39]=24,[40]=24,
        [41]=24,[42]=13,[43]=13,[44]=15,[45]=22,[46]=22,
        [47]=16,[48]=16,[49]=19,[50]=21,[51]=17,[52]=20,
        [53]=22,[54]=22,[55]=28,[56]=29,[57]=25,[58]=25,
        [59]=38,[60]=38,[61]=38,[62]=25,[63]=25,[64]=27,
        [65]=31,[66]=75,[67]=75,[68]=70,[69]=70,[70]=35,
        [71]=35,[72]=38,[73]=45,[74]=50,
        [75]=55,[76]=60
    }
    if jumping and dist <= 12 then
        return dist <= 10 and 20 or 15
    end
    return arcs[dist] or 60
end
 
-- SHOOT
local function shoot()
    local goal = select(2, getGoal())
    local arcValue = arc()
    if goal and arcValue and _G.Aimbot then
        local basketball = plr.Character and plr.Character:FindFirstChild("Basketball")
