local oobEnabled = false
local oobConnection = nil

-- The "Nuke" function: deletes anything with OOB in the name
local function nukeOOB(obj)
    if not oobEnabled then return end

    local name = obj.Name:lower() -- Convert to lowercase for easier matching
    
    -- Matches "OOBPart", "OOBKO", "OOBScriptBricks", "OOB Area", etc.
    if name:find("oob") or name == "script" or name == "script2" then
        -- Extra safety: Check if it's a script to disable it before deleting
        if obj:IsA("BaseScript") then
            obj.Disabled = true
        end
        
        -- Delete TouchInterests (the things that actually trigger the OOB lag/teleport)
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("TouchInterest") then
                child:Destroy()
            end
        end

        pcall(function() obj:Destroy() end)
    end
end

-- Function to scan the ENTIRE workspace and start a global listener
local function startGlobalNuke()
    -- 1. Immediate sweep of everything currently in the game
    for _, descendant in ipairs(workspace:GetDescendants()) do
        nukeOOB(descendant)
    end

    -- 2. Watch for anything new being added anywhere in the workspace
    oobConnection = workspace.DescendantAdded:Connect(nukeOOB)
end

