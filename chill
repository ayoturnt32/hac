local autoTuckConnection
local waitingForBind = false
local autoTuckSpeed = 12 

local windowActive = false
local windowEndTime = 0

-- Fixes the "15 never works" issue by ensuring the server registers the ball first
local function getDelay()
    if autoTuckSpeed >= 15 then
        return 0.025 -- The "Sweet Spot": Instant visual but server-safe
    end
    local maxDelay = 0.12
    local percent = math.clamp((autoTuckSpeed - 1) / 14, 0, 1)
    return math.max(0.025, maxDelay * (1 - percent))
end

-- Fixes the "Half of users" issue by manually overriding game values
local function forceTuckState()
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Force Hitbox Config
    pcall(function()
        local hitbox = char:FindFirstChild("Hitbox")
        local config = hitbox and hitbox:FindFirstChild("Configuration")
        if config and config:FindFirstChild("CanTuck") then
            config.CanTuck.Value = true
        end
    end)

    -- Force Session Data
    pcall(function()
        local pds = game:GetService("ReplicatedStorage"):FindFirstChild("PlayerDataStorage")
        local myData = pds and pds:FindFirstChild(tostring(LocalPlayer.UserId))
        local sessionData = myData and myData:FindFirstChild("SessionData")
        if sessionData and sessionData:FindFirstChild("Tucking") then
            sessionData.Tucking.Value = true
        end
    end)
end

local function monitorCatching(char)
    local hitbox = char:WaitForChild("Hitbox", 5)
    local charValues = hitbox and hitbox:WaitForChild("CharacterValues", 5)
    local catchingVal = charValues and charValues:WaitForChild("Catching", 5)

    if catchingVal then
        catchingVal:GetPropertyChangedSignal("Value"):Connect(function()
            if catchingVal.Value == true then
                windowActive = true
                windowEndTime = tick() + 5 
            end
        end)
    end
end

local function setupAutoTuck()
    if autoTuckConnection then autoTuckConnection:Disconnect() end
    if not autoTuckEnabled then return end

    autoTuckConnection = LocalPlayer.Character.ChildAdded:Connect(function(child)
        if child.Name == "Football" or child:IsA("Tool") then
            if windowActive or tick() < windowEndTime then
                
