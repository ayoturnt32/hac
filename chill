    if not basketball then return end
    local animFolder = basketball:FindFirstChild("Animations")
    if not animFolder then return end
    local shootAnim = animFolder:FindFirstChild("Shoot")
    if shootAnim then
        shootAnimTrack = animator:LoadAnimation(shootAnim)
    end
end
 
