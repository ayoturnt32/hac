local Navsploit_Storage = {
    Connections = {},
    Window = nil
}

getgenv().Navsploit_Unload = function()
    -- Closes the UI
    if Navsploit_Storage.Window then
        Navsploit_Storage.Window:Destroy()
    end
    -- Stops all loops and events (speed, magnets, etc)
    for _, conn in pairs(Navsploit_Storage.Connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    getgenv().Navsploit_Unload = nil
end

-- Function to track events so we can stop them later
local function track(conn)
    table.insert(Navsploit_Storage.Connections, conn)
    return conn
end

