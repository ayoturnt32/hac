-- [ CONTINUOUS SYNC LOOP ]
task.spawn(function()
    while true do
        local hum = getHum()
        if hum then
            -- SPEED LOGIC
            if not SpeedOverride.Value then
                -- Capture the game's actual speed as "Normal" while hack is OFF
                normalSpeed = hum.WalkSpeed
                -- Sync slider to show the game's speed
                if math.abs(WalkSpeedSlider.Value - normalSpeed) > 0.1 then
                    WalkSpeedSlider:SetValue(normalSpeed)
                end
            else
                -- Hack is ON: Force the slider value
                hum.WalkSpeed = WalkSpeedSlider.Value
            end

            -- JUMP LOGIC
            if not JumpOverride.Value then
                -- Capture the game's actual jump as "Normal" while hack is OFF
                normalJump = hum.JumpPower
                -- Sync slider
                if math.abs(JumpPowerSlider.Value - normalJump) > 0.1 then
                    JumpPowerSlider:SetValue(normalJump)
                end
            else
                -- Hack is ON: Force the slider value
                hum.JumpPower = JumpPowerSlider.Value
            end
        end
        task.wait(1) -- Check once per second
    end
end)

